# ══════════════════════════════════════════════════════════════════════════
#  Example `.env.development` — only the values that differ from `.env`.
#  Loaded automatically when NODE_ENV=development (the default).
#  Copy to `.env.development` if you want a dev-specific override file
#  instead of putting everything in `.env`.
# ══════════════════════════════════════════════════════════════════════════

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
MONGO_URI=mongodb://localhost:27017/zutsav

# Payments (see src/config/payment.config.js for the full mode rules):
#   PAYMENT_MODE=mock     local simulation — no PhonePe account/credentials
#                         needed; drive outcomes via
#                         POST /api/payments/mock/:merchantTransactionId
#   PAYMENT_MODE=sandbox  real PhonePe sandbox (needs PHONEPE_MERCHANT_ID /
#                         PHONEPE_SALT_KEY below or in System Settings)
# Unset here = sandbox (the pre-existing default).
#PAYMENT_MODE=mock
#MOCK_PAYMENT_OUTCOME=success
