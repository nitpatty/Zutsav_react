# ══════════════════════════════════════════════════════════════════════════
#  Zutsav Backend — Deployment Configuration
#  Copy this file to `.env` (or an environment-specific `.env.production` /
#  `.env.staging` / `.env.development`) and fill in real values.
#  See ../DEPLOYMENT_CONFIGURATION.md for the full guide.
# ══════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/zutsav
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Deployment URLs — the values that change on every new server/domain ──
# CLIENT_URL  = the public website (FRONTEND_URL is accepted as a legacy alias)
# SERVER_URL  = this backend's own public URL (BACKEND_URL accepted as alias)
# ADMIN_URL   = admin panel origin, if different from CLIENT_URL (defaults to CLIENT_URL)
# ADDITIONAL_CORS_ORIGINS = comma-separated extra origins to allow (staging, second brand, etc.)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
ADMIN_URL=
ADDITIONAL_CORS_ORIGINS=

# ── Company / Branding (shown in emails, invoices) ─────────────────────────
COMPANY_NAME=Zutsav Enterprises
COMPANY_LOGO=
SUPPORT_EMAIL=info@zutsav.com
SUPPORT_PHONE=+91-8851576605
COMPANY_GSTIN=09AAAFZ1234Z1Z5
COMPANY_PAN=AAAFZ1234Z
PRIVACY_URL=https://www.zutsav.com/privacy
TERMS_URL=https://www.zutsav.com/terms
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Razorpay (legacy — kept for old bookings) ───────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── PhonePe Standard Checkout (primary payment gateway) ─────────────────────
# PHONEPE_ENV=uat for sandbox, 'prod' for production
PHONEPE_ENV=uat
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1

# ── WhatsApp Cloud API (Meta Graph API) ─────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_VERSION=v18.0
# Inbound webhook: token echoed back during Meta's subscription verification
# (GET /api/webhooks/whatsapp), and the App Secret used to verify the
# X-Hub-Signature-256 header on every delivery. Both come from the Meta app
# dashboard. Also settable via Admin → Settings (whatsappVerifyToken /
# whatsappAppSecret keys).
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── Email Notifications (Nodemailer) ────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Set to 'true' to send email AND WhatsApp (default: email only when WhatsApp not configured)
NOTIFY_ALWAYS_EMAIL=false

# ── Groq AI (llama-3.3-70b-versatile) ───────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Sarvam AI (Indian-language translation — PRIMARY translation provider) ─
# Used server-side only by the content-translation engine
# (services/translationProviders/sarvam.provider.js); the key is never sent
# to browsers, logs, or API responses. Get a key at dashboard.sarvam.ai.
# When unset or failing, translation falls back to Groq (GROQ_API_KEY).
SARVAM_API_KEY=your_sarvam_api_key_here
# Optional: which provider to try FIRST — 'auto' (default: Sarvam, then
# Groq), 'sarvam', or 'groq'. The non-selected provider stays as fallback.
TRANSLATION_PROVIDER=auto

# ── FreeAstroAPI — Panchang (Tithi/Nakshatra/Yoga/Karana/Sunrise/Sunset/etc.) ─
# https://www.freeastroapi.com/docs/vedic/panchang — free-tier plans are
# quota-limited (~80 requests/day), so panchangService.js caches every
# lat/lon/timezone/date combination for 24h to stay well under that.
FREEASTRO_API_KEY=your_freeastroapi_key_here

# ── Ola Maps — place search / geocoding (temple location admin) ────────────
# Used server-side only by /api/location/*; the key is never sent to the
# browser. Also settable via Admin → System Configuration Center (key:
# olaMapsApiKey), which takes precedence over this env value. Without a key,
# location endpoints automatically fall back to Nominatim (OSM).
OLA_MAPS_API_KEY=

# ── Admin Seed (auto-created on first server start if unset) ───────────────
ADMIN_NAME=Admin
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ── Google Apps Script — Festival / Tithi / Panchang Sync ─────────────────
# Deploy backend/google-apps-script/FestivalSync.gs as a Web App
# (Execute as: Me, Access: Anyone) then paste the generated URL here.
GOOGLE_APPS_SCRIPT_URL=

# ── Tekipost Courier Integration ────────────────────────────────────────────
TEKIPOST_EMAIL=your_tekipost_login_email
TEKIPOST_PASSWORD=your_tekipost_password
TEKIPOST_SENDER_ADDRESS_ID=1
TEKIPOST_LOGISTICS_ID=0

# ── Uploaded file storage ───────────────────────────────────────────────────
UPLOAD_PATH=uploads

# ── Not yet integrated in this codebase ─────────────────────────────────────
# Cloudinary: schema fields exist for a future migration off local disk
# storage, but no SDK is installed and no code calls it today.
# CLOUDINARY_CLOUD_NAME=
