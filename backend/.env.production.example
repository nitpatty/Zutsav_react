# ══════════════════════════════════════════════════════════════════════════
#  Example `.env.production` — only the values that differ from `.env`.
#  Loaded automatically when NODE_ENV=production. Copy to `.env.production`
#  on the production server; secrets can stay in the base `.env` if you
#  prefer one file, or be split out here — either works.
#
#  When NODE_ENV=production, startup validation additionally requires
#  MONGO_URI, CLIENT_URL and SERVER_URL to be explicitly set (see
#  src/config/validate.js) so a misconfigured server fails loudly instead
#  of silently running against localhost.
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
CLIENT_URL=https://app.zutsav.com
SERVER_URL=https://api.zutsav.com
ADMIN_URL=https://app.zutsav.com
ADDITIONAL_CORS_ORIGINS=https://frontend.zutsav.com
MONGO_URI=mongodb://127.0.0.1:27017/zutsav
PHONEPE_ENV=prod
