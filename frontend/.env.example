# ══════════════════════════════════════════════════════════════════════════
#  Zutsav Frontend — Deployment Configuration
#
#  NOTE: This project uses Create React App (react-scripts). Environment
#  variables MUST start with REACT_APP_ to be available in the browser
#  bundle, and are baked in at BUILD time (not read at runtime) — see
#  ../DEPLOYMENT_CONFIGURATION.md for how to inject these in Docker/CI.
# ══════════════════════════════════════════════════════════════════════════

# ── Backend connection ──────────────────────────────────────────────────
# REACT_APP_API_URL is the single source every API call, image URL, and
# Socket.IO connection derives from (see src/config/urls.config.js).
REACT_APP_API_URL=http://localhost:5000/api

# ── Public-facing URLs ───────────────────────────────────────────────────
REACT_APP_WEB_URL=http://localhost:3000
REACT_APP_ADMIN_URL=
REACT_APP_SUPPORT_EMAIL=info@zutsav.com
REACT_APP_PRIVACY_URL=
REACT_APP_TERMS_URL=

# ── Microsoft Clarity — User Behavior Analytics ─────────────────────────
# Get your Project ID from https://clarity.microsoft.com
# If empty, analytics is silently disabled (no errors, no console warnings).
REACT_APP_MICROSOFT_CLARITY_PROJECT_ID=
