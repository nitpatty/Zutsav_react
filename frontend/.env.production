# ══════════════════════════════════════════════════════════════════════════
#  Zutsav Frontend — PRODUCTION environment (loaded automatically by CRA
#  whenever `npm run build` runs; `npm start` ignores it and keeps using
#  `.env` → http://localhost:5000/api for local development).
#
#  Values here are baked into the bundle at BUILD time (see
#  ../DEPLOYMENT_CONFIGURATION.md §5), so a rebuild is required after any
#  change. This file is committed so a production build is reproducible from
#  a fresh clone even though the gitignored `.env` only holds dev values.
# ══════════════════════════════════════════════════════════════════════════

REACT_APP_API_URL=https://zutsav.com/api
REACT_APP_WEB_URL=https://zutsav.com
REACT_APP_MICROSOFT_CLARITY_PROJECT_ID=ub241qo9tz