# ─────────────────────────────────────────────────────────────────────────────
# Zutsav Mobile App — Environment Variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_* vars are bundled into the app and visible client-side — never
# put a secret (API key, token) behind an EXPO_PUBLIC_ prefix. AI chat calls
# go through the backend's /api/ai/chat proxy for exactly this reason; there
# is no Groq key in this app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: Use your local machine IP (not localhost — Android emulator can't
# reach localhost). Find your IP with `ipconfig` (Windows) or `ifconfig` (Mac/Linux).
# Example: http://192.168.1.100:5000/api
#
# Production: Your deployed backend URL (no trailing slash)
# Example: https://api.zutsav.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# ── Backend Base URL ──────────────────────────────────────────────────────────
# Same host as API_URL but without /api — used for constructing image/file URLs
# and the Socket.IO connection. Images are served at: ${EXPO_PUBLIC_BASE_URL}/uploads/<filename>
EXPO_PUBLIC_BASE_URL=http://192.168.1.100:5000

# ── Public Website URL ────────────────────────────────────────────────────────
# Used to build shareable links (e.g. referral links: ${EXPO_PUBLIC_WEB_URL}/r/<token>)
EXPO_PUBLIC_WEB_URL=https://app.zutsav.com

# ── Maps / place search ───────────────────────────────────────────────────────
# There is deliberately NO map or place-search key in the app. Ola Maps (place search, geocoding) is called only
# by the backend (/api/location/*); its credentials (OLA_MAPS_CLIENT_ID / OLA_MAPS_CLIENT_SECRET or OLA_MAPS_API_KEY)
# belong in backend/.env. See docs/ANDROID_RELEASE_AND_MAPS.md.

# ─────────────────────────────────────────────────────────────────────────────
# EAS Build Environments (set via eas.json → env, not needed in .env directly)
# ─────────────────────────────────────────────────────────────────────────────
# development: http://localhost:5000/api        (or local IP)
# preview:     https://staging.api.zutsav.com/api
# production:  https://api.zutsav.com/api
#
# Set EXPO_PUBLIC_API_URL / EXPO_PUBLIC_BASE_URL / EXPO_PUBLIC_WEB_URL in
# eas.json under build.{profile}.env — they override .env for EAS builds.
