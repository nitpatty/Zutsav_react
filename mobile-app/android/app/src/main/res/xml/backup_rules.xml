<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6–11 (android:fullBackupContent). The app is built with android:allowBackup="false", so this file is
  not used today; it exists so that flipping allowBackup later can never silently back up the session token
  (expo-secure-store), cached account data or the cart. Everything is excluded.
-->
<full-backup-content>
  <exclude domain="root" path="."/>
  <exclude domain="file" path="."/>
  <exclude domain="database" path="."/>
  <exclude domain="sharedpref" path="."/>
  <exclude domain="external" path="."/>
</full-backup-content>
